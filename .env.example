# Public app settings (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase key. Use the current sb_secret_... key.
# The app still accepts the legacy service_role key as a temporary fallback.
SUPABASE_SECRET_KEY=
# Optional legacy fallback only; do not use for a new project.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only random secret, at least 32 characters.
PUZZLE_SESSION_SECRET=
